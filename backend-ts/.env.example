# --- Server
PORT=3001
NODE_ENV=development

# --- Security
# REQUIRED in production (boot fails without it when NODE_ENV=production)
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins (default: local dev ports)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Database (previously hardcoded root/mysql - rotate the old password!)
DB_NAME=inventory
DB_USER=root
DB_PASSWORD=mysql
DB_HOST=localhost
DB_PORT=3306
DB_POOL_MAX=20

# --- Sentry
SENTRY_DSN=
